{
  "name": "taxi-park",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @taxi/web test:e2e",
    "db:generate": "pnpm --filter @taxi/api db:generate",
    "db:migrate": "pnpm --filter @taxi/api db:migrate",
    "db:seed": "pnpm --filter @taxi/api db:seed",
    "create-owner": "pnpm --filter @taxi/api create-owner"
  }
}
