# Copy to .env and fill in. Never commit .env.
NODE_ENV=development

# PostgreSQL connection for the API.
DATABASE_URL=postgres://taxi:taxi@localhost:5432/taxi_dev
# Used by `pnpm test`; the database name must contain "test" because it is wiped.
TEST_DATABASE_URL=postgres://taxi:taxi@localhost:5432/taxi_test

API_HOST=127.0.0.1
API_PORT=3000
# Public origin of the web app. Writes from any other Origin are refused.
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_PER_MINUTE=10
# true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# docker-compose only
POSTGRES_PASSWORD=change-me
PUBLIC_ORIGIN=http://localhost:8080
